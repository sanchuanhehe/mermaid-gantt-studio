{
  "name": "mermaid-gantt-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm --prefix editor start",
    "check": "npm run version:check && npm --prefix editor run check",
    "test": "npm --prefix editor test && node --test test/*.test.mjs && python3 -m unittest discover -s test -p \"test_*.py\"",
    "test:renderer": "npm --prefix renderer test",
    "setup:renderer": "npm --prefix renderer ci",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:check": "node scripts/version.mjs release",
    "release:package": "python3 scripts/package-release.py"
  }
}
